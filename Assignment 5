#include <stdio.h>
#include <string.h>

int main()
{
    char str1[100], str2[100], result[200];
    int choice;

    printf("Enter first string: ");
    gets(str1);

    printf("Enter second string: ");
    gets(str2);

    do
    {
        printf("\n\n----- STRING OPERATIONS -----\n");
        printf("1. String Length\n");
        printf("2. String Copy\n");
        printf("3. String Concatenation\n");
        printf("4. String Comparison\n");
        printf("5. Exit\n");

        printf("Enter your choice: ");
        if (scanf("%d", &choice) != 1)
        {
            printf("Invalid input!\n");
            return 1;
        }

        switch(choice)
        {
            case 1:
                printf("Length of first string = %lu", strlen(str1));
                break;

            case 2:
                strcpy(result, str1);
                printf("Copied string = %s", result);
                break;

            case 3:
                strcpy(result, str1);
                strcat(result, str2);
                printf("Concatenated string = %s", result);
                break;

            case 4:
                if(strcmp(str1, str2) == 0)
                    printf("Both strings are equal.");
                else if(strcmp(str1, str2) > 0)
                    printf("First string is greater than second string.");
                else
                    printf("First string is smaller than second string.");
                break;

            case 5:
                printf("Exiting program...");
                break;

            default:
                printf("Invalid choice! Please enter 1-5.");
        }

    } 
    while(choice != 5);

    return 0;
}
