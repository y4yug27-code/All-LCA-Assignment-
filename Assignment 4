#include <stdio.h>
int main()
{
    int a[10][10], b[10][10], sum[10][10], diff[10][10];
    int i, j, rows, cols;
    
    printf("Choices of operation:\n");
    printf("1. For addition \n");
    printf("2. For subtraction \n");
    
    int op;
    if (scanf("%d", &op) != 1 && scanf("%xd", &op) != 2)
    {
    printf("!!INVALID INPUT!! Please enter a number (1 or 2).\n");
    }
    printf("Enter number of rows and columns: ");
    scanf("%d %d", &rows, &cols);
    
    printf("Enter elements of first matrix:\n");
    for(i = 0; i < rows; i++)
    {                
        for(j = 0; j < cols; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }
    
    printf("Enter elements of second matrix:\n");
    for(i = 0; i < rows; i++)
    {
        for(j = 0; j< cols; j++)
        {
            scanf("%d", &b[i][j]);
        }
    }
    switch (op)
    {
	    case 1:
        for(i = 0; i< rows; i++)
        {
            for(j = 0; j < cols; j++)
            {
                sum[i][j] = a[i][j] + b[i][j];
            }
        }
        
        printf("The sum of two marices:\n");
        for(i = 0; i < rows; i++)
        {
            for(j = 0; j < cols; j++)
            {
                printf("%d\t", sum[i][j]);
            }
            printf("\n");
        }
        break;
         
        case 2:
        for(i = 0; i< rows; i++)
        {
            for(j = 0; j < cols; j++)
            {
                diff[i][j] = a[i][j] - b[i][j];
            }
        }
     
        printf("The difference of two marices:\n");
        for(i = 0; i < rows; i++)
        {
            for(j = 0; j < cols; j++)
            {
                printf("%d\t", diff[i][j]);
            }
            printf("\n");
        }
        break;

        default:
        printf("\n!!INVALID CHOICE OF OPERATION!!");
    }
    return 0;
}
